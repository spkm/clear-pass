{
    "name": "spkm/clear-pass",
    "description": "Integrate with the Aruba ClearPass API using SaloonPHP",
    "license": "MIT",
    "keywords": [
        "ClearPass",
        "Aruba",
        "HPE",
        "REST API",
        "Laravel"
    ],
    "authors": [
        {
            "name": "Simon Mitchell",
            "email": "hello@spkmitchell.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/cache": "^12.39||^13.0",
        "illuminate/collections": "^12.39||^13.0",
        "illuminate/contracts": "^12.39||^13.0",
        "illuminate/encryption": "^12.39||^13.0",
        "illuminate/support": "^12.39||^13.0",
        "saloonphp/cache-plugin": "^3.0",
        "saloonphp/laravel-plugin": "^4.0||^5.0",
        "saloonphp/pagination-plugin": "^2.0",
        "saloonphp/saloon": "^4.4",
        "spatie/laravel-package-tools": "^1.19"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.20",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0"
    },
    "autoload": {
        "psr-4": {
            "spkm\\ClearPass\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spkm\\ClearPass\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "spkm\\ClearPass\\ClearPassServiceProvider"
            ],
            "aliases": {
                "ClearPass": "spkm\\ClearPass\\Facades\\ClearPass"
            }
        }
    },
    "scripts": {
        "post-install-cmd": "@hooks",
        "post-update-cmd": "@hooks",
        "hooks": "php -r \"is_dir('.git') && exec('git config core.hooksPath .githooks');\"",
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
